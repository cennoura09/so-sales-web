# Banco de dados (PostgreSQL, ex.: Supabase ou RDS). Sem isso, os leads não são persistidos.
DATABASE_URL=postgres://usuario:senha@host:5432/so_sales

# CRM próprio: endpoint que recebe o lead por POST (ver docs/crm-integration.md)
CRM_WEBHOOK_URL=https://crm.exemplo.com.br/api/webhooks/so-sales
CRM_WEBHOOK_SECRET=troque-por-um-segredo-longo

# WhatsApp da So Sales, com DDI + DDD + número, só dígitos (ex.: 5531999999999)
WHATSAPP_NUMBER=5531900000000

# Endereço público do site (usado em links absolutos e metadados)
NEXT_PUBLIC_SITE_URL=https://www.sosales.com.br
